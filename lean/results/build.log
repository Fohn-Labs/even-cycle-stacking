def TreeStack.mass.{u_1} : {V : Type u_1} → [Fintype V] → TreeStack.Configuration V → ℕ :=
fun {V} [Fintype V] C => ∑ v, C v
def TreeStack.PebbleStep.{u_1} : {V : Type u_1} →
  [DecidableEq V] → SimpleGraph V → TreeStack.Configuration V → TreeStack.Configuration V → Prop :=
fun {V} [DecidableEq V] G C D => ∃ u v, G.Adj u v ∧ 2 ≤ C u ∧ D = TreeStack.move C u v
def TreeStack.Reach.{u_1} : {V : Type u_1} →
  [DecidableEq V] → SimpleGraph V → TreeStack.Configuration V → TreeStack.Configuration V → Prop :=
fun {V} [DecidableEq V] G C D => Relation.ReflTransGen (TreeStack.PebbleStep G) C D
def TreeStack.StackedAt.{u_1} : {V : Type u_1} → TreeStack.Configuration V → V → Prop :=
fun {V} C r => 0 < C r ∧ ∀ (v : V), v ≠ r → C v = 0
def TreeStack.StackableAt.{u_1} : {V : Type u_1} →
  [DecidableEq V] → SimpleGraph V → TreeStack.Configuration V → V → Prop :=
fun {V} [DecidableEq V] G C r => ∃ D, TreeStack.Reach G C D ∧ TreeStack.StackedAt D r
def TreeStack.Stackable.{u_1} : {V : Type u_1} → [DecidableEq V] → SimpleGraph V → TreeStack.Configuration V → Prop :=
fun {V} [DecidableEq V] G C => ∃ r, TreeStack.StackableAt G C r
def CycleStack.cycleGraph : (N : ℕ) → SimpleGraph (Fin N) :=
fun N => { Adj := fun u v => u ≠ v ∧ ((↑u + 1) % N = ↑v ∨ (↑v + 1) % N = ↑u), symm := ⋯, loopless := ⋯ }
def CycleStack.evenCycle : (n : ℕ) → SimpleGraph (Fin (2 * n)) :=
fun n => CycleStack.cycleGraph (2 * n)
def CycleStack.EvenCycleUpper : ℕ → Prop :=
fun n => TreeStack.UniversalStackable (CycleStack.evenCycle n) (CycleStack.cycleThreshold n)
def CycleStack.cycleLowerConfig : (n : ℕ) → TreeStack.Configuration (Fin (2 * n)) :=
fun n v => if ↑v = 0 then 2 ^ (n + 1) - 3 else if ↑v = n then 1 else 0
def CycleStack.EvenCycleLowerObstruction : ℕ → Prop :=
fun n => ∃ C, TreeStack.mass C + 1 = CycleStack.cycleThreshold n ∧ ¬TreeStack.Stackable (CycleStack.evenCycle n) C
def CycleStack.IsStackingNumber.{u_1} : {V : Type u_1} → [Fintype V] → [DecidableEq V] → SimpleGraph V → ℕ → Prop :=
fun {V} [Fintype V] [DecidableEq V] G S =>
  2 ≤ S ∧ TreeStack.UniversalStackable G S ∧ ∀ (t : ℕ), 2 ≤ t → TreeStack.UniversalStackable G t → S ≤ t
def CycleStack.stackingNumber.{u_1} : {V : Type u_1} → [Fintype V] → [DecidableEq V] → SimpleGraph V → ℕ :=
fun {V} [Fintype V] [DecidableEq V] G => sInf {t | 2 ≤ t ∧ TreeStack.UniversalStackable G t}
